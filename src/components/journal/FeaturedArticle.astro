---
import TagLinks from "../content/TagLinks.astro";
import type { ResolvedTag } from "../../lib/tags";

interface Props {
  title: string;
  excerpt: string;
  image?: string;
  category: string;
  date: string;
  href: string;
  variant?: "overlay" | "split";
  tags?: ResolvedTag[];
}

const {
  title,
  excerpt,
  image,
  category,
  date,
  href,
  variant = "overlay",
  tags = [],
} = Astro.props;
---

<section class:list={["featured", { "featured--split": variant === "split" }]}>

  {image ? (
    <img
      src={image}
      alt={title}
    />
  ) : (
    <div class="image-placeholder" aria-hidden="true">
      <span>{category}</span>
    </div>
  )}

  <div class="overlay">

    <div class="content">

      <div class="meta">
        {category} · {date}
      </div>

      <h2>
        {title}
      </h2>

      <p>
        {excerpt}
      </p>

      <a href={href}>
        Read Article →
      </a>

      <TagLinks {tags} label={`${title} tags`} compact />

    </div>

  </div>

</section>


<style>

.featured {

  position:relative;

  overflow:hidden;

  border-radius:var(--radius-md);

}

.featured--split {
  display: grid;
  grid-template-columns: minmax(0, 1.35fr) minmax(280px, .95fr);
  gap: clamp(2rem, 5vw, 4rem);
  align-items: center;
  overflow: visible;
  border-radius: 0;
}


.featured img {

  width:100%;

  aspect-ratio:21 / 9;

  object-fit:cover;

}

.featured--split img,
.featured--split .image-placeholder {
  aspect-ratio: 16 / 11;
  border-radius: var(--radius-sm);
}

.image-placeholder {

  display:grid;

  place-items:center;

  width:100%;

  aspect-ratio:21 / 9;

  background:var(--bg-elevated);

  color:var(--accent);

  font-family:var(--font-ui);

  font-size:.85rem;

  font-weight:700;

  letter-spacing:.08em;

  text-transform:uppercase;

}


.overlay {

  position:absolute;

  inset:0;

  display:flex;

  align-items:flex-end;

  padding:3rem;

  background:
    linear-gradient(
      transparent,
      rgba(0,0,0,.85)
    );

}

.featured--split .overlay {
  position: static;
  display: block;
  padding: 0;
  background: none;
}

.featured--split .content h2 {
  color: var(--text-primary);
  font-size: clamp(2rem, 4vw, 3.15rem);
  line-height: 1.08;
}

.featured--split .content p {
  color: var(--text-secondary);
}

.featured--split .content a {
  color: var(--accent);
}

.content :global(.tag-links) {
  margin-top: var(--space-sm);
}


.content {

  max-width:700px;

}


.meta {

  color:var(--accent);

  font-size:.85rem;

  font-weight:700;

  letter-spacing:.08em;

  text-transform:uppercase;

}


.content h2 {

  color:white;

  margin:.75rem 0;

}


.content p {

  color:#f2f4f5;

}


.content a {

  color:white;

  font-weight:700;

}


@media(max-width:800px){

.featured--split {
  grid-template-columns: 1fr;
}

.overlay {

padding:1.5rem;

}

}

</style>
