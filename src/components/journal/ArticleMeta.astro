---
interface Props {
  category: string;
  date: Date;
  updatedDate?: Date;
}

const {
  category,
  date,
  updatedDate,
} = Astro.props;

const dateFormatter = new Intl.DateTimeFormat("en-US", {
  dateStyle: "long",
  timeZone: "UTC",
});
---

<div class="article-meta" aria-label="Article information">
  <span class="category">{category}</span>

  <span aria-hidden="true">•</span>

  <time datetime={date.toISOString()}>
    {dateFormatter.format(date)}
  </time>

  {updatedDate && (
    <span class="updated">
      Updated <time datetime={updatedDate.toISOString()}>
        {dateFormatter.format(updatedDate)}
      </time>
    </span>
  )}

</div>

<style>
  .article-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: var(--space-sm);
    color: var(--text-secondary);
    font-family: var(--font-ui);
    font-size: 0.85rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .category {
    color: var(--accent);
    font-weight: 700;
  }

  .updated {
    flex-basis: 100%;
  }

</style>
