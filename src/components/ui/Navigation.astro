---
import { getCollection, getEntry } from "astro:content";

const siteEntry = await getEntry("settings", "site");

if (!siteEntry) {
  throw new Error("Missing site settings: src/content/settings/site.md");
}

const site = siteEntry.data;
const flexiblePages = await getCollection(
  "flexiblePages",
  ({ data }) => !data.draft,
);

const normalizePath = (path: string) => {
  if (path === "/") return path;
  return path.replace(/\/$/, "");
};

const toPageHref = (path: string) => {
  const normalized = path.replace(/^\/+|\/+$/g, "");
  return normalized ? `/${normalized}/` : "/";
};

const fixedPageReferences: Record<string, string> = {
  "src/content/pages/home.md": "/",
  "src/content/pages/journal.md": "/journal/",
  "src/content/pages/about.md": "/about/",
  "src/content/pages/contact.md": "/contact/",
  "src/content/pages/resume.md": "/resume/",
};

const flexiblePageReferences = new Map(
  flexiblePages.map((page) => [
    page.id.replace(/\.md$/, ""),
    toPageHref(page.data.path),
  ]),
);

const resolvePageReference = (reference?: string) => {
  if (!reference) return undefined;
  if (fixedPageReferences[reference]) return fixedPageReferences[reference];

  const pageId = reference
    .replace(/^src\/content\/flexible-pages\//, "")
    .replace(/\.md$/, "");

  return flexiblePageReferences.get(pageId);
};

const resolveDestination = (item: {
  label: string;
  page?: string;
  href?: string;
}) => {
  const href = resolvePageReference(item.page) ?? item.href?.trim();
  return href ? { label: item.label, href } : undefined;
};

const navigation = site.navigation.flatMap((item, index) => {
  const children = item.children.flatMap((child) => {
    const resolvedChild = resolveDestination(child);
    return resolvedChild ? [resolvedChild] : [];
  });
  const destination = resolveDestination(item);

  if (!destination && children.length === 0) return [];

  return [{
    label: destination?.label ?? item.label,
    href: destination?.href,
    children,
    submenuId: `primary-submenu-${index}`,
  }];
});

const currentPath = normalizePath(Astro.url.pathname);
const isExactPage = (href: string) => currentPath === normalizePath(href);
const isWithinPage = (href: string) => {
  const itemPath = normalizePath(href);
  if (itemPath === "/") return currentPath === "/";
  return currentPath === itemPath || currentPath.startsWith(`${itemPath}/`);
};
const isItemCurrent = (item: (typeof navigation)[number]) =>
  (item.href ? isWithinPage(item.href) : false) ||
  item.children.some((child) => isWithinPage(child.href));
---

<nav class="site-nav" aria-label="Primary navigation">
  <div class="nav-container">
    <a href="/" class="logo" aria-current={currentPath === "/" ? "page" : undefined}>
      <img class="logo-mark" src="/favicon.svg" alt="" aria-hidden="true" />
      <span>{site.logoText}</span>
    </a>

    <button
      class="nav-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="primary-nav-links"
    >
      <span class="nav-toggle-label">Menu</span>
      <span class="nav-toggle-icon" aria-hidden="true">
        <span></span>
        <span></span>
        <span></span>
      </span>
    </button>

    <ul class="nav-links" id="primary-nav-links">
      {navigation.map((item) => (
        <li
          class:list={["nav-item", { "has-children": item.children.length > 0 }]}
          data-current={isItemCurrent(item) ? "true" : undefined}
        >
          <div class="nav-item-heading">
            {item.href ? (
              <a
                class="nav-link"
                href={item.href}
                aria-current={isExactPage(item.href) ? "page" : undefined}
              >
                {item.label}
              </a>
            ) : (
              <button
                class="nav-link menu-label-toggle"
                type="button"
                aria-expanded="false"
                aria-controls={item.submenuId}
                aria-label={`Open ${item.label} submenu`}
              >
                <span>{item.label}</span>
                <span class="menu-label-arrow" aria-hidden="true">▾</span>
              </button>
            )}

            {item.href && item.children.length > 0 && (
              <button
                class="submenu-toggle"
                type="button"
                aria-expanded="false"
                aria-controls={item.submenuId}
                aria-label={`Open ${item.label} submenu`}
              >
                <span aria-hidden="true">▾</span>
              </button>
            )}
          </div>

          {item.children.length > 0 && (
            <ul class="nav-submenu" id={item.submenuId}>
              {item.children.map((child) => (
                <li>
                  <a
                    href={child.href}
                    aria-current={isExactPage(child.href) ? "page" : undefined}
                  >
                    {child.label}
                  </a>
                </li>
              ))}
            </ul>
          )}
        </li>
      ))}
    </ul>
  </div>
</nav>

<script>
  document.documentElement.classList.add("js");

  const navigation = document.querySelector<HTMLElement>(".site-nav");
  const toggle = navigation?.querySelector<HTMLButtonElement>(".nav-toggle");
  const toggleLabel = toggle?.querySelector<HTMLElement>(".nav-toggle-label");
  const menuLinks = navigation?.querySelectorAll<HTMLAnchorElement>(".nav-links a");
  const submenuToggles = navigation?.querySelectorAll<HTMLButtonElement>(
    ".submenu-toggle, .menu-label-toggle",
  );

  const closeSubmenus = (except?: HTMLButtonElement, returnFocus = false) => {
    submenuToggles?.forEach((submenuToggle) => {
      if (submenuToggle === except) return;

      const item = submenuToggle.closest<HTMLElement>(".nav-item");
      const wasOpen = submenuToggle.getAttribute("aria-expanded") === "true";
      item?.removeAttribute("data-submenu-open");
      submenuToggle.setAttribute("aria-expanded", "false");
      submenuToggle.setAttribute(
        "aria-label",
        submenuToggle.getAttribute("aria-label")?.replace(/^Close /, "Open ") ?? "Open submenu",
      );

      if (returnFocus && wasOpen) submenuToggle.focus();
    });
  };

  const setMenuState = (isOpen: boolean, returnFocus = false) => {
    if (!navigation || !toggle || !toggleLabel) return;

    navigation.toggleAttribute("data-menu-open", isOpen);
    toggle.setAttribute("aria-expanded", String(isOpen));
    toggleLabel.textContent = isOpen ? "Close" : "Menu";

    if (!isOpen) closeSubmenus();
    if (returnFocus) toggle.focus();
  };

  toggle?.addEventListener("click", () => {
    const isOpen = toggle.getAttribute("aria-expanded") === "true";
    setMenuState(!isOpen);
  });

  submenuToggles?.forEach((submenuToggle) => {
    submenuToggle.addEventListener("click", () => {
      const item = submenuToggle.closest<HTMLElement>(".nav-item");
      const isOpen = submenuToggle.getAttribute("aria-expanded") === "true";

      closeSubmenus(submenuToggle);
      item?.toggleAttribute("data-submenu-open", !isOpen);
      submenuToggle.setAttribute("aria-expanded", String(!isOpen));
      submenuToggle.setAttribute(
        "aria-label",
        `${isOpen ? "Open" : "Close"} ${item?.querySelector(".nav-link")?.textContent?.trim() ?? ""} submenu`,
      );
    });
  });

  menuLinks?.forEach((link) => {
    link.addEventListener("click", () => setMenuState(false));
  });

  document.addEventListener("keydown", (event) => {
    if (event.key !== "Escape") return;

    const openSubmenu = navigation?.querySelector<HTMLButtonElement>(
      '.submenu-toggle[aria-expanded="true"], .menu-label-toggle[aria-expanded="true"]',
    );

    if (openSubmenu) {
      closeSubmenus(undefined, true);
      return;
    }

    if (navigation?.hasAttribute("data-menu-open")) {
      setMenuState(false, true);
    }
  });

  document.addEventListener("click", (event) => {
    if (!(event.target instanceof Node) || navigation?.contains(event.target)) return;

    closeSubmenus();
    if (navigation?.hasAttribute("data-menu-open")) setMenuState(false);
  });

  window.matchMedia("(min-width: 769px)").addEventListener("change", (event) => {
    if (event.matches) setMenuState(false);
  });
</script>

<style>
.site-nav {
  position: sticky;
  top: 0;
  z-index: 1000;
  background: var(--bg-primary);
  border-bottom: 1px solid rgba(255,255,255,.08);
  backdrop-filter: blur(10px);
}

.nav-container {
  max-width: 1200px;
  margin: 0 auto;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 1rem 2rem;
}

.logo {
  display: inline-flex;
  align-items: center;
  gap: .65rem;
  font-family: var(--font-ui);
  font-size: 1.2rem;
  font-weight: 700;
  color: var(--text-primary);
  text-decoration: none;
  letter-spacing: .03em;
}

.logo-mark {
  display: block;
  width: 2rem;
  height: 2rem;
  flex: 0 0 auto;
  border-radius: 50%;
}

.nav-toggle {
  display: none;
  align-items: center;
  gap: .65rem;
  min-height: 44px;
  padding: .5rem .75rem;
  border: 1px solid var(--border-color);
  border-radius: var(--radius-sm);
  background: var(--bg-surface);
  color: var(--text-primary);
  font: inherit;
  font-weight: 700;
  cursor: pointer;
}

.nav-toggle-icon {
  display: grid;
  gap: 4px;
  width: 20px;
}

.nav-toggle-icon span {
  display: block;
  width: 100%;
  height: 2px;
  border-radius: 2px;
  background: currentColor;
  transition: transform .2s ease, opacity .2s ease;
}

.site-nav[data-menu-open] .nav-toggle-icon span:nth-child(1) {
  transform: translateY(6px) rotate(45deg);
}

.site-nav[data-menu-open] .nav-toggle-icon span:nth-child(2) {
  opacity: 0;
}

.site-nav[data-menu-open] .nav-toggle-icon span:nth-child(3) {
  transform: translateY(-6px) rotate(-45deg);
}

.nav-links,
.nav-submenu {
  list-style: none;
  margin: 0;
  padding: 0;
}

.nav-links {
  display: flex;
  align-items: flex-start;
  gap: 1.65rem;
}

.nav-item {
  position: relative;
}

.nav-item-heading {
  display: flex;
  align-items: center;
}

.nav-links a,
.menu-label-toggle {
  color: var(--text-secondary);
  text-decoration: none;
  font-family: var(--font-ui);
  font-size: .95rem;
  font-weight: 500;
  transition: color .2s ease;
}

.nav-link {
  display: inline-flex;
  align-items: center;
  min-height: 36px;
}

.menu-label-toggle {
  gap: .35rem;
  padding: 0;
  border: 0;
  background: transparent;
  cursor: pointer;
}

.menu-label-arrow {
  transition: transform .2s ease;
}

.nav-links a:hover,
.nav-links a:focus-visible,
.menu-label-toggle:hover,
.menu-label-toggle:focus-visible,
.nav-item[data-current="true"] > .nav-item-heading > .nav-link {
  color: var(--text-primary);
}

.nav-links a[aria-current="page"] {
  color: var(--text-primary);
  text-decoration: underline;
  text-decoration-color: var(--accent);
  text-decoration-thickness: 2px;
  text-underline-offset: .45rem;
}

.submenu-toggle {
  display: none;
  align-items: center;
  justify-content: center;
  width: 32px;
  min-height: 36px;
  padding: 0;
  border: 0;
  background: transparent;
  color: var(--text-secondary);
  font: inherit;
  cursor: pointer;
}

:global(.js) .submenu-toggle {
  display: inline-flex;
}

.submenu-toggle span {
  transition: transform .2s ease;
}

.nav-item[data-submenu-open] .submenu-toggle span {
  transform: rotate(180deg);
}

.nav-item[data-submenu-open] .menu-label-arrow {
  transform: rotate(180deg);
}

.nav-submenu {
  display: flex;
  flex-direction: column;
  gap: .2rem;
  padding: .35rem 0 0 1rem;
}

:global(.js) .nav-submenu {
  position: absolute;
  top: calc(100% + .55rem);
  left: 0;
  display: none;
  min-width: 210px;
  padding: .45rem;
  border: 1px solid var(--border-color);
  border-radius: var(--radius-sm);
  background: var(--bg-surface);
  box-shadow: var(--shadow-soft);
}

:global(.js) .nav-item[data-submenu-open] .nav-submenu {
  display: flex;
}

.nav-submenu a {
  display: block;
  padding: .65rem .75rem;
  border-radius: var(--radius-sm);
  white-space: nowrap;
}

.nav-submenu a:hover,
.nav-submenu a:focus-visible {
  background: rgba(255,255,255,.05);
  color: var(--accent);
}

@media (max-width: 768px) {
  .nav-container {
    position: relative;
    flex-wrap: wrap;
    padding: .75rem 1rem;
  }

  .logo {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  :global(.js) .nav-toggle {
    display: inline-flex;
  }

  .nav-links {
    width: 100%;
    flex-direction: column;
    gap: 0;
    padding-top: .75rem;
    border-top: 1px solid var(--border-color);
  }

  :global(.js) .nav-links {
    position: absolute;
    top: 100%;
    right: 0;
    left: 0;
    display: none;
    max-height: calc(100vh - 68px);
    overflow-y: auto;
    padding: .5rem 1rem 1rem;
    border-top: 1px solid var(--border-color);
    background: var(--bg-primary);
    box-shadow: var(--shadow-soft);
  }

  :global(.js) .site-nav[data-menu-open] .nav-links {
    display: flex;
  }

  .nav-item,
  .nav-item-heading {
    width: 100%;
  }

  .nav-item-heading {
    justify-content: space-between;
  }

  .nav-link {
    flex: 1;
    min-height: 44px;
    padding: .6rem 0;
  }

  .submenu-toggle {
    width: 44px;
    min-height: 44px;
  }

  :global(.js) .nav-submenu {
    position: static;
    min-width: 0;
    margin: 0 0 .35rem .75rem;
    padding: .2rem 0 .35rem .75rem;
    border: 0;
    border-left: 2px solid var(--border-color);
    border-radius: 0;
    background: transparent;
    box-shadow: none;
  }

  .nav-submenu a {
    min-height: 44px;
    padding: .7rem .75rem;
    white-space: normal;
  }

  .nav-links a[aria-current="page"] {
    text-underline-offset: .3rem;
  }
}
</style>
