---
interface Competency {
  title: string;
  description: string;
}

interface ExperienceItem {
  period: string;
  title: string;
  organization?: string;
  location?: string;
  description?: string;
  highlights?: string[];
}

interface EducationItem {
  degree: string;
  institution: string;
  focus?: string;
  period?: string;
}

interface Props {
  professionalSummary?: string;
  competencies?: Competency[];
  experience?: ExperienceItem[];
  education?: EducationItem[];
}

const {
  professionalSummary = "",
  competencies = [],
  experience = [],
  education = [],
} = Astro.props;

const summaryParagraphs = professionalSummary
  .split(/\n\s*\n/)
  .map((paragraph) => paragraph.trim())
  .filter(Boolean);
---

<div class="resume-profile">
  {summaryParagraphs.length > 0 && (
    <section class="resume-intro" aria-labelledby="resume-profile-heading">
      <div class="section-heading">
        <p class="section-kicker">Profile</p>
        <h2 id="resume-profile-heading">Strategy, communication, and hands-on execution.</h2>
      </div>
      <div class="summary-copy">
        {summaryParagraphs.map((paragraph) => <p>{paragraph}</p>)}
      </div>
    </section>
  )}

  {competencies.length > 0 && (
    <section class="resume-section" aria-labelledby="capabilities-heading">
      <div class="section-heading">
        <p class="section-kicker">Capabilities</p>
        <h2 id="capabilities-heading">What I bring to the work</h2>
      </div>
      <div class="capability-grid">
        {competencies.map((competency) => (
          <article class="capability-card">
            <h3>{competency.title}</h3>
            <p>{competency.description}</p>
          </article>
        ))}
      </div>
    </section>
  )}

  {experience.length > 0 && (
    <section class="resume-section" aria-labelledby="experience-heading">
      <div class="section-heading">
        <p class="section-kicker">Experience</p>
        <h2 id="experience-heading">Professional background</h2>
      </div>
      <div class="experience-list">
        {experience.map((item) => (
          <article class="experience-card">
            <div class="experience-meta">
              <p class="period">{item.period}</p>
              {item.location && <p class="location">{item.location}</p>}
            </div>
            <div class="experience-content">
              <h3>{item.title}</h3>
              {item.organization && <p class="organization">{item.organization}</p>}
              {item.description && <p class="role-description">{item.description}</p>}
              {item.highlights && item.highlights.length > 0 && (
                <ul class="highlights">
                  {item.highlights.map((highlight) => <li>{highlight}</li>)}
                </ul>
              )}
            </div>
          </article>
        ))}
      </div>
    </section>
  )}

  {education.length > 0 && (
    <section class="resume-section" aria-labelledby="education-heading">
      <div class="section-heading">
        <p class="section-kicker">Education</p>
        <h2 id="education-heading">Education & credentials</h2>
      </div>
      <div class="education-grid">
        {education.map((item) => (
          <article class="education-card">
            <div>
              <h3>{item.degree}</h3>
              <p class="institution">{item.institution}</p>
              {item.focus && <p>{item.focus}</p>}
            </div>
            {item.period && <p class="period">{item.period}</p>}
          </article>
        ))}
      </div>
    </section>
  )}
</div>

<style>
  .resume-profile {
    display: grid;
    gap: var(--space-xl);
  }

  .resume-intro,
  .resume-section {
    display: grid;
    gap: var(--space-md);
  }

  .section-heading {
    max-width: 42rem;
  }

  .section-kicker {
    margin: 0 0 0.35rem;
    color: var(--accent);
    font-family: var(--font-ui);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .section-heading h2 {
    margin: 0;
  }

  .summary-copy {
    max-width: 46rem;
  }

  .summary-copy p {
    font-family: var(--font-editorial);
    font-size: 1.08rem;
  }

  .summary-copy p:last-child {
    margin-bottom: 0;
  }

  .capability-grid,
  .education-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-sm);
  }

  .capability-card,
  .education-card {
    padding: var(--space-md);
    background: var(--bg-surface);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
  }

  .capability-card h3,
  .capability-card p,
  .education-card h3,
  .education-card p {
    margin: 0;
  }

  .capability-card p,
  .education-card p {
    margin-top: 0.45rem;
  }

  .experience-list {
    border-top: 1px solid var(--border-color);
  }

  .experience-card {
    display: grid;
    grid-template-columns: minmax(8.5rem, 0.34fr) minmax(0, 1fr);
    gap: var(--space-lg);
    padding: var(--space-lg) 0;
    border-bottom: 1px solid var(--border-color);
  }

  .experience-card h3,
  .experience-card p {
    margin-top: 0;
  }

  .experience-card h3 {
    margin-bottom: 0.25rem;
    font-size: clamp(1.35rem, 2.5vw, 1.8rem);
  }

  .experience-meta p {
    font-family: var(--font-ui);
  }

  .period {
    margin: 0;
    color: var(--accent);
    font-family: var(--font-ui);
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .location {
    margin: 0.4rem 0 0;
    color: var(--text-secondary);
    font-size: 0.88rem;
  }

  .organization {
    margin-bottom: var(--space-sm);
    color: var(--text-secondary);
    font-family: var(--font-ui);
    font-weight: 700;
  }

  .role-description {
    max-width: 44rem;
  }

  .highlights {
    margin-bottom: 0;
    padding-left: 1.2rem;
  }

  .highlights li + li {
    margin-top: 0.55rem;
  }

  .education-card {
    display: flex;
    justify-content: space-between;
    gap: var(--space-md);
  }

  .institution {
    font-family: var(--font-ui);
    font-weight: 700;
  }

  @media (max-width: 720px) {
    .capability-grid,
    .education-grid {
      grid-template-columns: 1fr;
    }

    .experience-card {
      grid-template-columns: 1fr;
      gap: var(--space-sm);
      padding: var(--space-md) 0;
    }

    .education-card {
      display: block;
    }
  }

  @media print {
    .resume-profile {
      gap: 1.5rem;
    }

    .capability-card,
    .education-card {
      break-inside: avoid;
      background: transparent;
      border-color: #999;
    }

    .experience-card {
      break-inside: avoid;
    }
  }
</style>
