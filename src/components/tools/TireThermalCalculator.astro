  .methodology { overflow: hidden; }
  .methodology summary { padding: 1rem 1.25rem; cursor: pointer; font-weight: 800; }
  .methodology[open] summary { border-bottom: 1px solid var(--border-color); }
  .methodology-body { padding-top: 1rem; }
  .methodology-body p { margin: 0 0 1rem; line-height: 1.6; }
  .formula { overflow-x: auto; padding: 0.85rem 1rem; border-radius: var(--radius-sm); background: var(--bg-primary); font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; }
  .safety-note { font-size: 0.86rem; line-height: 1.55; }

  @media (max-width: 850px) {
    .calculator-grid { grid-template-columns: 1fr; }
  }

  @media (max-width: 560px) {
    .field-grid,
    .result-details { grid-template-columns: 1fr; }
  }
</style>
