  .status-copy { margin: 0 0 var(--space-md); line-height: 1.55; }

  .result-details {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.8rem;
    margin: auto 0 0;
  }

  .result-details div {
    padding-top: 0.7rem;
    border-top: 1px solid var(--border-color);
  }

  .result-details dt { color: var(--text-secondary); font-size: 0.76rem; line-height: 1.3; }
