<section class="tire-thermal-calculator" aria-labelledby="tire-thermal-title">
  <div class="calculator-grid">
    <form id="tire-thermal-form" class="input-panel">
      <div class="panel-heading">
        <p class="kicker">Inputs</p>
        <h2 id="tire-thermal-title">Tire Thermal Risk Estimator</h2>
        <p>
          Enter the conditions leading up to the reading, then the hottest IR
          surface temperature you measured.
        </p>
      </div>

      <div class="field-grid">
        <label class="field">
          <span>Ambient temperature</span>
          <span class="input-wrap">
            <input id="ambient" name="ambient" type="number" inputmode="decimal" value="90" min="-40" max="150" step="1" required />
            <span class="unit">°F</span>
          </span>
        </label>

        <label class="field">
          <span>Cold tire pressure</span>
          <span class="input-wrap">
            <input id="psi" name="psi" type="number" inputmode="decimal" value="35" min="5" max="120" step="0.5" required />
            <span class="unit">psi</span>
          </span>
        </label>

        <label class="field">
          <span>Sustained speed</span>
          <span class="input-wrap">
            <input id="speed" name="speed" type="number" inputmode="decimal" value="65" min="0" max="120" step="1" required />
            <span class="unit">mph</span>
          </span>
        </label>

        <label class="field">
          <span>Time at speed</span>
          <span class="input-wrap">
            <input id="minutes" name="minutes" type="number" inputmode="decimal" value="30" min="0" max="240" step="1" required />
            <span class="unit">min</span>
          </span>
        </label>

        <label class="field field--wide">
          <span>Measured IR surface temperature</span>
          <span class="input-wrap input-wrap--primary">
            <input id="irTemp" name="irTemp" type="number" inputmode="decimal" value="150" min="-40" max="350" step="1" required />
            <span class="unit">°F</span>
          </span>
          <small>Use the hottest repeatable reading from the same tire area.</small>
        </label>
      </div>
    </form>

    <section id="result-card" class="result-card" data-status="yellow" aria-live="polite">
      <p class="result-label">Estimated internal temperature</p>
      <div class="result-temperature"><span id="internal-temp">—</span><span>°F</span></div>
      <div class="status-row">
        <span id="status-dot" class="status-dot" aria-hidden="true"></span>
        <strong id="status-label">Calculating…</strong>
      </div>
      <p id="status-copy" class="status-copy"></p>

      <dl class="result-details">
        <div>
          <dt>IR → core estimate</dt>
          <dd>+<span id="thermal-delta">—</span>°F</dd>
        </div>
        <div>
          <dt>Model-predicted core</dt>
          <dd><span id="modeled-core">—</span>°F</dd>
        </div>
        <div>
          <dt>Model-predicted surface</dt>
          <dd><span id="modeled-surface">—</span>°F</dd>
        </div>
        <div>
          <dt>Measured vs. predicted IR</dt>
          <dd><span id="surface-difference">—</span>°F</dd>
        </div>
      </dl>

      <p id="pressure-note" class="pressure-note"></p>
    </section>
  </div>

  <details class="methodology">
    <summary>How this estimate works</summary>
    <div class="methodology-body">
      <p>
        The calculator uses the measured IR temperature as the anchor for its
        internal-temperature estimate. It adds a modeled surface-to-core
        differential based on sustained speed and time at speed.
      </p>
      <p class="formula">
        Estimated core = measured IR + (25 + 0.9 × speed) × (1 − e<sup>−time/12</sup>)
      </p>
      <p>
        Ambient temperature and cold pressure are used separately to reproduce
        the original spreadsheet's expected thermal-load model:
      </p>
      <p class="formula">
        Modeled core = ambient + ((0.8 × speed + 30) × (35 / PSI)<sup>1.6</sup>) × (1 − e<sup>−time/15</sup>)
      </p>
      <p>
        The 35 psi value is a reference point inherited from the original model,
        not a recommended pressure for every tire or vehicle.
      </p>
    </div>
  </details>

  <aside class="safety-note">
    <strong>Important:</strong> This is an experimental thermal-risk estimator,
    not a manufacturer specification or a determination that a tire is safe to
    operate. Tire construction, load, inflation requirements, age, prior damage,
    measurement location, and IR emissivity can materially change actual casing
    temperature and failure risk. Follow the vehicle and tire manufacturer's
    pressure, load, speed, inspection, and replacement guidance.
  </aside>
</section>

<script>
  const form = document.querySelector<HTMLFormElement>("#tire-thermal-form");
  const resultCard = document.querySelector<HTMLElement>("#result-card");

  const fields = {
    ambient: document.querySelector<HTMLInputElement>("#ambient"),
    psi: document.querySelector<HTMLInputElement>("#psi"),
    speed: document.querySelector<HTMLInputElement>("#speed"),
    minutes: document.querySelector<HTMLInputElement>("#minutes"),
    irTemp: document.querySelector<HTMLInputElement>("#irTemp"),
  };

  const output = {
    internalTemp: document.querySelector<HTMLElement>("#internal-temp"),
    statusLabel: document.querySelector<HTMLElement>("#status-label"),
    statusCopy: document.querySelector<HTMLElement>("#status-copy"),
    thermalDelta: document.querySelector<HTMLElement>("#thermal-delta"),
    modeledCore: document.querySelector<HTMLElement>("#modeled-core"),
    modeledSurface: document.querySelector<HTMLElement>("#modeled-surface"),
    surfaceDifference: document.querySelector<HTMLElement>("#surface-difference"),
    pressureNote: document.querySelector<HTMLElement>("#pressure-note"),
  };

  const GREEN_LIMIT_F = 180;
  const RED_LIMIT_F = 225;
  const PRESSURE_REFERENCE_PSI = 35;

  const read = (field: HTMLInputElement | null) => field ? Number(field.value) : Number.NaN;
  const round = (value: number) => Math.round(value);
  const signed = (value: number) => `${value >= 0 ? "+" : ""}${round(value)}`;

  function calculate() {
    if (!form || !resultCard) return;

    const ambient = read(fields.ambient);
    const psi = read(fields.psi);
    const speed = read(fields.speed);
    const minutes = read(fields.minutes);
    const measuredIr = read(fields.irTemp);

    const valid = [ambient, psi, speed, minutes, measuredIr].every(Number.isFinite) && psi > 0 && speed >= 0 && minutes >= 0;
    if (!valid) return;

    const surfaceToCore = (25 + 0.9 * speed) * (1 - Math.exp(-minutes / 12));
    const inferredCore = measuredIr + surfaceToCore;

    const pressureFactor = Math.pow(PRESSURE_REFERENCE_PSI / psi, 1.6);
    const modeledCore = ambient + ((0.8 * speed + 30) * pressureFactor) * (1 - Math.exp(-minutes / 15));
    const modeledSurface = modeledCore - surfaceToCore;
    const surfaceDifference = measuredIr - modeledSurface;

    let status = "green";
    let label = "GREEN — LOWER THERMAL RISK";
    let copy = "The estimated internal temperature is below this model's caution band. Continue to use manufacturer pressure/load guidance and inspect any tire showing abnormal heat or behavior.";

    if (inferredCore >= RED_LIMIT_F) {
      status = "red";
      label = "RED — HIGH THERMAL RISK";
      copy = "The estimated internal temperature is in this model's highest-risk band. Reduce thermal load and inspect the tire before relying on continued operation. This estimate does not determine whether damage has already occurred.";
    } else if (inferredCore >= GREEN_LIMIT_F) {
      status = "yellow";
      label = "YELLOW — ELEVATED THERMAL RISK";
      copy = "The estimated internal temperature is elevated in this model. Consider reducing speed/load, allowing cooling time, and checking inflation and tire condition before prolonged operation.";
    }

    resultCard.dataset.status = status;
    if (output.internalTemp) output.internalTemp.textContent = String(round(inferredCore));
    if (output.statusLabel) output.statusLabel.textContent = label;
    if (output.statusCopy) output.statusCopy.textContent = copy;
    if (output.thermalDelta) output.thermalDelta.textContent = String(round(surfaceToCore));
    if (output.modeledCore) output.modeledCore.textContent = String(round(modeledCore));
    if (output.modeledSurface) output.modeledSurface.textContent = String(round(modeledSurface));
    if (output.surfaceDifference) output.surfaceDifference.textContent = signed(surfaceDifference);

    if (output.pressureNote) {
      const factorPercent = Math.round((pressureFactor - 1) * 100);
      if (Math.abs(factorPercent) < 3) {
        output.pressureNote.textContent = `Cold pressure is essentially at the model's ${PRESSURE_REFERENCE_PSI} psi reference point.`;
      } else {
        output.pressureNote.textContent = `In the original thermal-load model, ${psi} psi produces a ${Math.abs(factorPercent)}% ${factorPercent > 0 ? "higher" : "lower"} pressure-related heat factor than the ${PRESSURE_REFERENCE_PSI} psi reference. This is model context, not a pressure recommendation.`;
      }
    }
  }

  form?.addEventListener("input", calculate);
  calculate();
</script>

