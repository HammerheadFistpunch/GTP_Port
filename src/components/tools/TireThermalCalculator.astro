<section class="tire-thermal-calculator" aria-labelledby="tire-thermal-title">
  <div class="calculator-grid">
    <form id="tire-thermal-form" class="input-panel">
      <div class="panel-heading">
        <p class="kicker">Inputs</p>
        <h2 id="tire-thermal-title">Tire Thermal Risk Estimator</h2>
        <p>
          Compare cold and hot pressure with an IR surface reading. The calculator
          reports measured/derived heat signals and an experimental thermal-risk band.
        </p>
      </div>

      <div class="field-grid">
        <label class="field">
          <span>Starting tire / ambient temperature</span>
          <span class="input-wrap">
            <input id="ambient" name="ambient" type="number" inputmode="decimal" value="70" min="-40" max="150" step="1" required />
            <span class="unit">°F</span>
          </span>
          <small>Assumes the tire was stabilized near ambient before driving.</small>
        </label>

        <label class="field">
          <span>Cold tire pressure</span>
          <span class="input-wrap">
            <input id="coldPsi" name="coldPsi" type="number" inputmode="decimal" value="35" min="5" max="120" step="0.5" required />
            <span class="unit">psi</span>
          </span>
        </label>

        <label class="field">
          <span>Hot tire pressure</span>
          <span class="input-wrap input-wrap--primary">
            <input id="hotPsi" name="hotPsi" type="number" inputmode="decimal" value="40" min="5" max="140" step="0.5" required />
            <span class="unit">psi</span>
          </span>
          <small>Measure promptly after the run, before meaningful cooling.</small>
        </label>

        <label class="field">
          <span>Measured IR surface temperature</span>
          <span class="input-wrap input-wrap--primary">
            <input id="irTemp" name="irTemp" type="number" inputmode="decimal" value="140" min="-40" max="350" step="1" required />
            <span class="unit">°F</span>
          </span>
          <small>Use the hottest repeatable reading from the same tire area.</small>
        </label>

        <label class="field">
          <span>Sustained speed</span>
          <span class="input-wrap">
            <input id="speed" name="speed" type="number" inputmode="decimal" value="65" min="0" max="120" step="1" required />
            <span class="unit">mph</span>
          </span>
        </label>

        <label class="field">
          <span>Time at speed</span>
          <span class="input-wrap">
            <input id="minutes" name="minutes" type="number" inputmode="decimal" value="30" min="0" max="240" step="1" required />
            <span class="unit">min</span>
          </span>
        </label>
      </div>
    </form>

    <section id="result-card" class="result-card" data-status="yellow" aria-live="polite">
      <p class="result-label">Thermal condition</p>
      <div class="result-risk"><span id="risk-word">—</span></div>
      <div class="status-row">
        <span class="status-dot" aria-hidden="true"></span>
        <strong id="status-label">Calculating…</strong>
      </div>
      <p id="status-copy" class="status-copy"></p>

      <dl class="result-details">
        <div>
          <dt>Pressure rise</dt>
          <dd><span id="pressure-rise">—</span> psi</dd>
        </div>
        <div>
          <dt>Pressure rise</dt>
          <dd><span id="pressure-percent">—</span>%</dd>
        </div>
        <div>
          <dt>Estimated internal air temp</dt>
          <dd>~<span id="air-temp">—</span>°F</dd>
        </div>
        <div>
          <dt>Estimated internal air rise</dt>
          <dd><span id="air-rise">—</span>°F</dd>
        </div>
        <div>
          <dt>IR surface temperature</dt>
          <dd><span id="surface-temp">—</span>°F</dd>
        </div>
        <div>
          <dt>IR rise above ambient</dt>
          <dd><span id="surface-rise">—</span>°F</dd>
        </div>
      </dl>

      <p id="context-note" class="context-note"></p>
    </section>
  </div>

  <details class="methodology">
    <summary>How this estimate works</summary>
    <div class="methodology-body">
      <p>
        Pressure and IR temperature are treated as two independent heat signals.
        The calculator does not attempt to convert tread temperature into carcass
        temperature.
      </p>
      <p>
        The internal-air estimate uses the ideal gas relationship with gauge pressure
        converted to absolute pressure. It assumes tire volume is approximately constant
        and that the starting tire temperature was near the entered ambient temperature.
      </p>
      <p class="formula">
        T₂ = T₁ × (P₂ + 14.7) / (P₁ + 14.7)
      </p>
      <p>
        Temperatures are converted to an absolute scale for the calculation. The result
        estimates the temperature of the contained air, not the hottest rubber, belt,
        bead, or carcass temperature.
      </p>
      <p>
        The NORMAL / ELEVATED / HIGH indicator is an experimental heuristic combining
        pressure-rise percentage, IR rise above ambient, and prolonged high-speed exposure.
        It is deliberately a risk indicator rather than a claimed tire-damage threshold.
      </p>
    </div>
  </details>

  <aside class="safety-note">
    <strong>Important:</strong> This tool is experimental and is not a manufacturer
    specification or a determination that a tire is safe to operate. Tire construction,
    load, required inflation, age, prior damage, measurement location, gauge accuracy,
    cooling delay, and IR emissivity can materially change the readings. Follow the tire
    and vehicle manufacturer's pressure, load, speed, inspection, and replacement guidance.
  </aside>
</section>

<script>
  const form = document.querySelector<HTMLFormElement>("#tire-thermal-form");
  const resultCard = document.querySelector<HTMLElement>("#result-card");

  const fields = {
    ambient: document.querySelector<HTMLInputElement>("#ambient"),
    coldPsi: document.querySelector<HTMLInputElement>("#coldPsi"),
    hotPsi: document.querySelector<HTMLInputElement>("#hotPsi"),
    irTemp: document.querySelector<HTMLInputElement>("#irTemp"),
    speed: document.querySelector<HTMLInputElement>("#speed"),
    minutes: document.querySelector<HTMLInputElement>("#minutes"),
  };

  const output = {
    riskWord: document.querySelector<HTMLElement>("#risk-word"),
    statusLabel: document.querySelector<HTMLElement>("#status-label"),
    statusCopy: document.querySelector<HTMLElement>("#status-copy"),
    pressureRise: document.querySelector<HTMLElement>("#pressure-rise"),
    pressurePercent: document.querySelector<HTMLElement>("#pressure-percent"),
    airTemp: document.querySelector<HTMLElement>("#air-temp"),
    airRise: document.querySelector<HTMLElement>("#air-rise"),
    surfaceTemp: document.querySelector<HTMLElement>("#surface-temp"),
    surfaceRise: document.querySelector<HTMLElement>("#surface-rise"),
    contextNote: document.querySelector<HTMLElement>("#context-note"),
  };

  const ATM_PSI = 14.7;
  const F_TO_R_OFFSET = 459.67;

  const read = (field: HTMLInputElement | null) => field ? Number(field.value) : Number.NaN;
  const round = (value: number) => Math.round(value);
  const oneDecimal = (value: number) => value.toFixed(1);
  const signed = (value: number, digits = 0) => `${value >= 0 ? "+" : ""}${digits ? value.toFixed(digits) : Math.round(value)}`;

  function calculate() {
    if (!form || !resultCard) return;

    const ambient = read(fields.ambient);
    const coldPsi = read(fields.coldPsi);
    const hotPsi = read(fields.hotPsi);
    const measuredIr = read(fields.irTemp);
    const speed = read(fields.speed);
    const minutes = read(fields.minutes);

    const valid = [ambient, coldPsi, hotPsi, measuredIr, speed, minutes].every(Number.isFinite)
      && coldPsi > 0 && hotPsi > 0 && speed >= 0 && minutes >= 0;
    if (!valid) return;

    const pressureRise = hotPsi - coldPsi;
    const pressureRisePct = (pressureRise / coldPsi) * 100;

    const startRankine = ambient + F_TO_R_OFFSET;
    const coldAbsolute = coldPsi + ATM_PSI;
    const hotAbsolute = hotPsi + ATM_PSI;
    const estimatedAirRankine = startRankine * (hotAbsolute / coldAbsolute);
    const estimatedAirF = estimatedAirRankine - F_TO_R_OFFSET;
    const estimatedAirRise = estimatedAirF - ambient;

    const surfaceRise = measuredIr - ambient;

    let score = 0;
    if (pressureRisePct >= 20) score += 2;
    else if (pressureRisePct >= 10) score += 1;

    if (surfaceRise >= 90) score += 2;
    else if (surfaceRise >= 50) score += 1;

    const prolongedHighSpeed = speed >= 70 && minutes >= 30;
    if (prolongedHighSpeed) score += 1;

    let status = "green";
    let riskWord = "NORMAL";
    let label = "NORMAL — LOWER OBSERVED THERMAL LOAD";
    let copy = "The measured pressure and surface-temperature changes do not show multiple strong heat signals in this experimental model. Continue to use manufacturer pressure/load guidance and investigate any abnormal tire behavior.";

    if (score >= 4) {
      status = "red";
      riskWord = "HIGH";
      label = "HIGH — MULTIPLE THERMAL RISK SIGNALS";
      copy = "Pressure rise, surface heating, and/or operating exposure indicate substantial heat accumulation. Reduce thermal load where practical and inspect the tire before relying on continued operation.";
    } else if (score >= 2) {
      status = "yellow";
      riskWord = "ELEVATED";
      label = "ELEVATED — INCREASED THERMAL LOAD";
      copy = "One or more measurements indicate meaningful heat accumulation. Watch the trend, confirm inflation and load are appropriate, and consider reducing speed/load or allowing cooling if readings continue to climb.";
    }

    if (pressureRise < 0) {
      status = "yellow";
      riskWord = "CHECK";
      label = "CHECK — HOT PRESSURE BELOW COLD PRESSURE";
      copy = "The entered hot pressure is lower than the cold pressure. That is unusual after sustained driving and may indicate cooling before measurement, a pressure loss, differing gauges, or an input error. Verify the tire before interpreting thermal risk.";
    }

    resultCard.dataset.status = status;
    if (output.riskWord) output.riskWord.textContent = riskWord;
    if (output.statusLabel) output.statusLabel.textContent = label;
    if (output.statusCopy) output.statusCopy.textContent = copy;
    if (output.pressureRise) output.pressureRise.textContent = signed(pressureRise, 1);
    if (output.pressurePercent) output.pressurePercent.textContent = signed(pressureRisePct, 1);
    if (output.airTemp) output.airTemp.textContent = String(round(estimatedAirF));
    if (output.airRise) output.airRise.textContent = signed(estimatedAirRise);
    if (output.surfaceTemp) output.surfaceTemp.textContent = String(round(measuredIr));
    if (output.surfaceRise) output.surfaceRise.textContent = signed(surfaceRise);

    if (output.contextNote) {
      const exposure = prolongedHighSpeed
        ? ` The ${speed} mph / ${minutes} minute exposure adds context because it represents prolonged high-speed operation.`
        : ` Speed and duration are shown as operating context and do not directly generate a temperature estimate.`;
      output.contextNote.textContent = `Internal-air temperature is an ideal-gas estimate from the pressure change; it is not carcass temperature.${exposure}`;
    }
  }

  form?.addEventListener("input", calculate);
  calculate();
</script>

<style>
  .tire-thermal-calculator {
    --risk-green: #2e7d32;
    --risk-green-soft: rgba(46, 125, 50, 0.12);
    --risk-yellow: #a56500;
    --risk-yellow-soft: rgba(196, 125, 0, 0.14);
    --risk-red: #b3261e;
    --risk-red-soft: rgba(179, 38, 30, 0.12);
    display: grid;
    gap: var(--space-md);
    font-family: var(--font-ui);
  }

  .calculator-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(280px, 0.75fr);
    gap: var(--space-md);
    align-items: stretch;
  }

  .input-panel,
  .result-card,
  .methodology,
  .safety-note {
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    background: var(--bg-surface);
  }

  .input-panel,
  .result-card,
  .methodology-body,
  .safety-note {
    padding: clamp(1.25rem, 3vw, 2rem);
  }

  .panel-heading { margin-bottom: var(--space-md); }
  .panel-heading h2 { margin: 0.2rem 0 0.65rem; font-size: clamp(1.7rem, 3vw, 2.35rem); }
  .panel-heading p:last-child,
  .field small,
  .methodology-body,
  .context-note,
  .safety-note { color: var(--text-secondary); }

  .kicker,
  .result-label {
    margin: 0;
    color: var(--accent);
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }

  .field-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }

  .field { display: grid; gap: 0.45rem; font-weight: 700; }
  .field small { font-size: 0.8rem; font-weight: 400; line-height: 1.45; }

  .input-wrap {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    min-height: 3.25rem;
    overflow: hidden;
    border: 1px solid var(--border-color);
    border-radius: var(--radius-sm);
    background: var(--bg-primary);
  }

  .input-wrap:focus-within { outline: 2px solid var(--accent); outline-offset: 2px; }
  .input-wrap--primary { border-width: 2px; }

  input {
    width: 100%;
    min-width: 0;
    border: 0;
    outline: 0;
    padding: 0.8rem 0.9rem;
    background: transparent;
    color: var(--text-primary);
    font: inherit;
    font-size: 1.1rem;
    font-weight: 700;
  }

  .unit { padding: 0 0.9rem 0 0.25rem; color: var(--text-secondary); font-size: 0.88rem; }

  .result-card {
    position: relative;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border-top: 0.4rem solid var(--risk-yellow);
    background: linear-gradient(180deg, var(--risk-yellow-soft), var(--bg-surface) 42%);
  }

  .result-card[data-status="green"] {
    border-top-color: var(--risk-green);
    background: linear-gradient(180deg, var(--risk-green-soft), var(--bg-surface) 42%);
  }

  .result-card[data-status="red"] {
    border-top-color: var(--risk-red);
    background: linear-gradient(180deg, var(--risk-red-soft), var(--bg-surface) 42%);
  }

  .result-risk {
    margin: 0.35rem 0 0.5rem;
    font-size: clamp(3rem, 7vw, 5.2rem);
    font-weight: 900;
    line-height: 0.95;
    letter-spacing: -0.05em;
  }

  .status-row { display: flex; align-items: center; gap: 0.55rem; margin: 0.4rem 0 0.8rem; }
  .status-dot { width: 0.72rem; height: 0.72rem; flex: 0 0 auto; border-radius: 50%; background: var(--risk-yellow); }
  [data-status="green"] .status-dot { background: var(--risk-green); }
