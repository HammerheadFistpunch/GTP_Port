---
import {
  getCollection,
  render,
  type CollectionEntry,
} from "astro:content";
import FlexiblePageLayout from "../layouts/FlexiblePageLayout.astro";
import {
  normalizeFlexiblePagePath,
  validateFlexiblePagePath,
} from "../lib/flexible-pages";

export async function getStaticPaths() {
  const pages = await getCollection("flexiblePages");
  const publishedPages = pages.filter((page) => !page.data.draft);
  const routes = new Map<string, string>();

  return publishedPages.map((page) => {
    const error = validateFlexiblePagePath(page.data.path);

    if (error) {
      throw new Error(`Invalid Flexible Page path in ${page.id}: ${error}`);
    }

    const path = normalizeFlexiblePagePath(page.data.path);
    const existingPage = routes.get(path);

    if (existingPage) {
      throw new Error(
        `Duplicate Flexible Page path "${path}" in ${existingPage} and ${page.id}.`,
      );
    }

    routes.set(path, page.id);

    return {
      params: { path },
      props: { page },
    };
  });
}

interface Props {
  page: CollectionEntry<"flexiblePages">;
}

const { page } = Astro.props;
const { Content } = await render(page);
---

<FlexiblePageLayout {...page.data}>
  <Content />
</FlexiblePageLayout>
