---
import {
  getCollection,
  render,
  type CollectionEntry,
} from "astro:content";
import FlexiblePageLayout from "../layouts/FlexiblePageLayout.astro";
import PageBlockRenderer from "../components/flexible/PageBlockRenderer.astro";
import {
  normalizeFlexiblePagePath,
  validateFlexiblePagePath,
} from "../lib/flexible-pages";

const RESERVED_STATIC_PATHS = new Set(["tools/tire-thermal"]);

export async function getStaticPaths() {
  const pages = await getCollection("flexiblePages");
  const publishedPages = pages.filter((page) => {
    if (page.data.draft) return false;
    return !RESERVED_STATIC_PATHS.has(normalizeFlexiblePagePath(page.data.path));
  });
  const routes = new Map<string, string>();

  const pageByPath = new Map(
    publishedPages.map((page) => [
      normalizeFlexiblePagePath(page.data.path),
      page,
    ]),
  );

  return publishedPages.map((page) => {
    const error = validateFlexiblePagePath(page.data.path);

    if (error) {
      throw new Error(`Invalid Flexible Page path in ${page.id}: ${error}`);
    }

    const path = normalizeFlexiblePagePath(page.data.path);
    const existingPage = routes.get(path);

    if (existingPage) {
      throw new Error(
        `Duplicate Flexible Page path "${path}" in ${existingPage} and ${page.id}.`,
      );
    }

    routes.set(path, page.id);

    const segments = path.split("/");
    const breadcrumbs = segments.slice(0, -1).flatMap((_, index) => {
      const ancestorPath = segments.slice(0, index + 1).join("/");
      const ancestor = pageByPath.get(ancestorPath);

      if (!ancestor) return [];

      return [{
        label: ancestor.data.navigationLabel || ancestor.data.title,
        href: `/${ancestorPath}/`,
      }];
    });

    return {
      params: { path },
      props: { page, breadcrumbs, flexiblePages: pages },
    };
  });
}

interface Props {
  page: CollectionEntry<"flexiblePages">;
  breadcrumbs: Array<{ label: string; href: string }>;
  flexiblePages: CollectionEntry<"flexiblePages">[];
}

const { page, breadcrumbs, flexiblePages } = Astro.props;
const { Content } = await render(page);
---

<FlexiblePageLayout {...page.data} {breadcrumbs}>
  <PageBlockRenderer blocks={page.data.blocks} {flexiblePages} />
  <Content />
</FlexiblePageLayout>
