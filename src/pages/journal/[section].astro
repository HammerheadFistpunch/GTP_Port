---
import { getCollection, getEntry } from "astro:content";
import JournalLanding, { type JournalPostSummary } from "../../components/journal/JournalLanding.astro";
import {
  createJournalSectionRegistry,
  journalSectionMatches,
  type ResolvedJournalSection,
} from "../../lib/journal-sections";
import { createTagRegistry, resolveTagReferences } from "../../lib/tags";

export async function getStaticPaths() {
  const registry = createJournalSectionRegistry(await getCollection("journalSections"));
  return registry.active.flatMap((section) => [section.slug, ...section.aliases].map((route) => ({
    params: { section: route },
    props: { section, sections: registry.active },
  })));
}

interface Props {
  section: ResolvedJournalSection;
  sections: ResolvedJournalSection[];
}

const { section, sections } = Astro.props;
const journalPage = await getEntry("pages", "journal");

if (!journalPage || journalPage.data.pageType !== "archive") {
  throw new Error("Missing Journal page content: src/content/pages/journal.md");
}

const page = journalPage.data;
const tagRegistry = createTagRegistry(await getCollection("tags"));
const dateFormatter = new Intl.DateTimeFormat("en-US", { dateStyle: "long", timeZone: "UTC" });
const entries = (await getCollection("entries", ({ data }) =>
  !data.draft && journalSectionMatches(data.journalSection, section)
)).sort((a, b) => (b.data.date?.getTime() ?? 0) - (a.data.date?.getTime() ?? 0));

const posts: JournalPostSummary[] = entries.map((entry) => ({
  title: entry.data.title,
  excerpt: entry.data.description,
  image: entry.data.coverImage,
  date: entry.data.date ? dateFormatter.format(entry.data.date) : "Date pending",
  section: section.label,
  href: `/archive/${entry.id}/`,
  tags: resolveTagReferences(entry.data.tags, tagRegistry, entry.data.title),
}));
---

<JournalLanding
  title={`${section.label} | ${page.title}`}
  eyebrow={`${page.title} section`}
  headline={section.label}
  description={section.description}
  sectionTitle={`${section.label} entries`}
  emptyMessage={`No published ${section.label} entries yet.`}
  posts={posts}
  sections={sections}
  activeSection={section.slug}
/>
