---
import { getCollection, getEntry } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PortfolioBentoCard from "../../components/portfolio/PortfolioBentoCard.astro";
import Container from "../../components/ui/Container.astro";
import { resolvePortfolioTiles } from "../../lib/portfolio-tiles";

const portfolioEntries = (await getCollection("entries", ({ data }) =>
  !data.draft && (data.placement === "portfolio" || data.placement === "both")
))
  .sort((a, b) => {
    if (a.data.portfolioOrder !== b.data.portfolioOrder) {
      return a.data.portfolioOrder - b.data.portfolioOrder;
    }

    if (a.data.featured !== b.data.featured) {
      return Number(b.data.featured) - Number(a.data.featured);
    }

    return a.data.title.localeCompare(b.data.title);
  });

const portfolioPage = await getEntry("pages", "portfolio");

if (!portfolioPage || portfolioPage.data.pageType !== "archive") {
  throw new Error("Missing Portfolio page content: src/content/pages/portfolio.md");
}

const page = portfolioPage.data;
const flexiblePages = await getCollection("flexiblePages");
const selectedTiles = resolvePortfolioTiles(
  page.portfolioTiles,
  portfolioEntries,
  flexiblePages,
);
const tiles = page.portfolioTiles.length > 0
  ? selectedTiles
  : portfolioEntries.map((entry) => ({
      title: entry.data.title,
      description: entry.data.description,
      image: entry.data.coverImage,
      category: entry.data.primaryTopic,
      entryType: entry.data.entryType,
      tileSize: entry.data.tileSize,
      href: `/archive/${entry.id}/`,
      emphasis: entry.data.featured,
    }));
---

<BaseLayout
  title={page.title}
  description={page.description}
>
  <section class:list={["archive-hero", `archive-hero--${page.headerStyle}`]}>
    <Container>
      {page.eyebrow && <p class="eyebrow">{page.eyebrow}</p>}
      <h1>{page.headline}</h1>
      <p class="introduction">{page.description}</p>
    </Container>
  </section>

  <section class="archive-list" aria-labelledby="portfolio-projects">
    <Container>
      <h2 id="portfolio-projects">{page.sectionTitle}</h2>

      {tiles.length > 0 ? (
        <div class:list={["project-grid", { "project-grid--exact": page.portfolioPacking === "exact" }]}>
          {tiles.map((tile) => (
            <PortfolioBentoCard
              title={tile.title}
              description={tile.description}
              image={tile.image}
              category={tile.category}
              entryType={tile.entryType}
              tileSize={tile.tileSize}
              href={tile.href}
              emphasis={tile.emphasis}
            />
          ))}
        </div>
      ) : (
        <p>{page.emptyMessage}</p>
      )}
    </Container>
  </section>
</BaseLayout>

<style>
  .archive-hero {
    padding: var(--space-lg) 0;
    border-bottom: 1px solid var(--border-color);
  }

  .archive-hero--featured {
    padding: var(--space-xl) 0 var(--space-lg);
  }

  .eyebrow {
    margin-bottom: var(--space-sm);
    color: var(--accent);
    font-family: var(--font-ui);
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .archive-hero h1 {
    max-width: 22ch;
    font-size: clamp(2.25rem, 5vw, 3.75rem);
  }

  .archive-hero--featured h1 {
    max-width: 16ch;
    font-size: clamp(3rem, 7vw, 5.5rem);
  }

  .introduction {
    max-width: 44rem;
    font-size: 1.2rem;
  }

  .archive-list {
    padding-top: var(--space-lg);
  }

  .archive-list h2 {
    margin-bottom: var(--space-md);
  }

  .project-grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    grid-auto-flow: dense;
    grid-auto-rows: minmax(10rem, auto);
    gap: var(--space-md);
  }

  .project-grid--exact {
    grid-auto-flow: row;
  }
</style>
