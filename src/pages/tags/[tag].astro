---
import { getCollection } from "astro:content";
import TagArchive from "../../components/content/TagArchive.astro";
import type { JournalPostSummary } from "../../components/journal/JournalLanding.astro";
import { createJournalSectionRegistry, resolveJournalSection } from "../../lib/journal-sections";
import {
  createTagRegistry,
  resolveEffectiveTag,
  resolveTagReferences,
  tagHref,
} from "../../lib/tags";

export async function getStaticPaths() {
  const tagDocuments = await getCollection("tags");
  const entries = await getCollection("entries", ({ data }) => !data.draft);
  const registry = createTagRegistry(tagDocuments);
  const sectionRegistry = createJournalSectionRegistry(await getCollection("journalSections"));
  const dateFormatter = new Intl.DateTimeFormat("en-US", {
    dateStyle: "long",
    timeZone: "UTC",
  });

  const summaries = entries.map((entry) => {
    const tags = resolveTagReferences(entry.data.tags, registry, entry.data.title);
    const section = resolveJournalSection(entry.data.journalSection, sectionRegistry);

    return {
      entry,
      topicIds: new Set(tags.map((tag) => tag.id)),
      summary: {
        title: entry.data.title,
        excerpt: entry.data.description,
        image: entry.data.coverImage,
        date: entry.data.date
          ? dateFormatter.format(entry.data.date)
          : "Date pending",
        section: section?.label ?? "Latest",
        href: `/archive/${entry.id}/`,
        tags,
      } satisfies JournalPostSummary,
    };
  });

  return [...registry.byRoute.entries()].map(([route, storedTag]) => {
    const tag = resolveEffectiveTag(storedTag, registry);
    return {
      params: { tag: route },
      props: {
        tag,
        posts: summaries
          .filter(({ topicIds }) => topicIds.has(tag.id))
          .sort((a, b) =>
            (b.entry.data.date?.getTime() ?? 0) -
            (a.entry.data.date?.getTime() ?? 0) ||
            a.entry.data.title.localeCompare(b.entry.data.title)
          )
          .map(({ summary }) => summary),
        canonicalPath: route === tag.slug ? undefined : tagHref(tag.slug),
      },
    };
  });
}

const { tag, posts, canonicalPath } = Astro.props;
---

<TagArchive {tag} {posts} {canonicalPath} />
