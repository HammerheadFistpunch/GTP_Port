---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Container from "../../components/ui/Container.astro";
import TireThermalCalculator from "../../components/tools/TireThermalCalculator.astro";
---

<BaseLayout
  title="Tire Thermal Risk Estimator"
  description="Estimate internal tire temperature from an IR surface reading, speed, time, cold pressure, and ambient temperature."
  canonicalPath="/tools/tire-thermal/"
>
  <section class="tool-page">
    <Container width="wide">
      <header class="tool-header">
        <p class="eyebrow">Garage tool</p>
        <h1>Tire Thermal Risk Estimator</h1>
        <p class="lede">
          A simple experimental calculator for translating an IR tire-surface
          reading into an estimated internal temperature and thermal-risk band.
        </p>
      </header>

      <TireThermalCalculator />
    </Container>
  </section>
</BaseLayout>

<style>
  .tool-page {
    padding: var(--space-lg) 0 var(--space-xl);
  }

  .tool-header {
    width: min(860px, 100%);
    margin-bottom: var(--space-lg);
  }

  .eyebrow {
    margin: 0 0 0.45rem;
    color: var(--accent);
    font-family: var(--font-ui);
    font-size: 0.82rem;
    font-weight: 800;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }

  h1 {
    margin: 0;
    font-size: clamp(2.5rem, 6vw, 4.75rem);
  }

  .lede {
    max-width: 760px;
    margin: 1rem 0 0;
    color: var(--text-secondary);
    font-family: var(--font-ui);
    font-size: clamp(1rem, 2vw, 1.2rem);
    line-height: 1.6;
  }
</style>
