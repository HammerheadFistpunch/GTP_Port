---
import { getCollection, getEntry, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Container from "../../components/ui/Container.astro";
import PageBlockRenderer from "../../components/flexible/PageBlockRenderer.astro";
import TireThermalCalculator from "../../components/tools/TireThermalCalculator.astro";

const page = await getEntry("flexiblePages", "tools/tire-thermal");
if (!page) {
  throw new Error("Missing Custom Page content: tools/tire-thermal");
}

const flexiblePages = await getCollection("flexiblePages");
const { Content } = await render(page);
const breadcrumbs = [
  { label: "Tools", href: "/tools/" },
  { label: "Online Tools", href: "/tools/online/" },
];
---

<BaseLayout
  title={page.data.seoTitle || page.data.title}
  description={page.data.seoDescription || page.data.description}
  image={page.data.seoImage || undefined}
  canonicalPath="/tools/tire-thermal/"
>
  <section class="tool-page">
    <Container width="wide">
      <nav class="breadcrumbs" aria-label="Breadcrumb">
        <a href="/">Home</a>
        {breadcrumbs.map((item) => (
          <>
            <span aria-hidden="true">/</span>
            <a href={item.href}>{item.label}</a>
          </>
        ))}
        <span aria-hidden="true">/</span>
        <span aria-current="page">{page.data.title}</span>
      </nav>

      <header class="tool-header">
        {page.data.eyebrow && <p class="eyebrow">{page.data.eyebrow}</p>}
        <h1>{page.data.title}</h1>
        {page.data.description && <p class="lede">{page.data.description}</p>}
      </header>

      <TireThermalCalculator />

      <div class="cms-content">
        <PageBlockRenderer blocks={page.data.blocks} {flexiblePages} />
        <Content />
      </div>
    </Container>
  </section>
</BaseLayout>

<style>
  .tool-page {
    padding: var(--space-md) 0 var(--space-xl);
  }

  .breadcrumbs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin-bottom: var(--space-md);
    color: var(--text-secondary);
    font-family: var(--font-ui);
    font-size: 0.9rem;
  }

  .breadcrumbs a {
    color: inherit;
  }

  .breadcrumbs a:hover {
    color: var(--accent);
  }

  .tool-header {
    width: min(860px, 100%);
    margin-bottom: var(--space-lg);
  }

  .eyebrow {
    margin: 0 0 0.45rem;
    color: var(--accent);
    font-family: var(--font-ui);
    font-size: 0.82rem;
    font-weight: 800;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }

  h1 {
    margin: 0;
    font-size: clamp(2.5rem, 6vw, 4.75rem);
  }

  .lede {
    max-width: 760px;
    margin: 1rem 0 0;
    color: var(--text-secondary);
    font-family: var(--font-ui);
    font-size: clamp(1rem, 2vw, 1.2rem);
    line-height: 1.6;
  }

  .cms-content {
    width: min(860px, 100%);
    margin-top: var(--space-lg);
  }

  .cms-content :global(p:last-child) {
    margin-bottom: 0;
  }
</style>
